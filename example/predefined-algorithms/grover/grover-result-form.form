{
  "id": "grover-result-form",
  "type": "default",
  "schemaVersion": 12,
  "components": [
    {
      "type": "textfield",
      "key": "classicalResult.answer",
      "label": "Answer",
      "description": "Bitstring with the highest measurement probability.",
      "readonly": true
    },
    {
      "type": "textfield",
      "key": "classicalResult.target",
      "label": "Target",
      "readonly": true
    },
    {
      "type": "checkbox",
      "key": "classicalResult.found",
      "label": "Found",
      "description": "Whether the answer matches the target bitstring.",
      "readonly": true
    },
    {
      "type": "number",
      "key": "classicalResult.confidence",
      "label": "Confidence",
      "description": "Measurement probability of the answer bitstring.",
      "readonly": true
    },
    {
      "type": "separator"
    },
    {
      "type": "textfield",
      "key": "braketResult.resultS3Uri",
      "label": "Result S3 URI",
      "description": "S3 location of the raw Braket task result.",
      "readonly": true
    }
  ]
}
